pipeline {
    agent {
        label 'windows_node'
    }

    stages {

        stage('Build') {
            steps {
                bat 'Build.bat'
            }
        }

        stage('Testing') {
            parallel {

                stage('Unit Test') {
                    steps {
                        bat 'Unit.bat'
                    }
                }

                stage('Quality Check') {
                    steps {
                        bat 'Quality.bat'
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                bat 'Deploy.bat'
            }
        }
    }
}
